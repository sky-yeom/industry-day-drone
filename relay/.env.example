# Relay (Python) environment template.
# Copy to relay/.env (gitignored) and load it (e.g. `set -a; source relay/.env; set +a`)
# before starting the relay, or export the variables you need to override.
#
#   cp relay/.env.example relay/.env

# --- Emergency triage image analysis -----------------------------------------

# "mock" (default) skips Azure IMAGE analysis only. Voice Live still uses Azure
# and needs a signed-in credential (e.g. `az login` with resource access).
# Set to "azure" to use real multimodal image analysis.
TRIAGE_MODE=mock

# Required when TRIAGE_MODE=azure. Run `az login` first for Entra auth, or set
# AZURE_VISION_API_KEY instead (process env only — never commit a real key).
AZURE_VISION_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_VISION_DEPLOYMENT=YOUR-VISION-DEPLOYMENT
AZURE_VISION_API_VERSION=v1
# AZURE_VISION_API_KEY=

# --- Azure AI Foundry / Voice Live -------------------------------------------

VOICE_LIVE_RESOURCE=industry-day-drone-boot-resource
VOICE_LIVE_REGION=southeastasia
VOICE_LIVE_API_VERSION=2026-07-15
VOICE_LIVE_MODEL=gpt-realtime
VOICE_LIVE_VOICE=shimmer
VOICE_LIVE_VOICE_TYPE=openai

# --- Turn detection -----------------------------------------------------------

VOICE_LIVE_SILENCE_MS=300
VOICE_LIVE_VAD_TYPE=azure_semantic_vad_multilingual
VOICE_LIVE_VAD_LANGUAGES=ko
VOICE_LIVE_VAD_THRESHOLD=0.5
VOICE_LIVE_PREFIX_PADDING_MS=420
VOICE_LIVE_SPEECH_DURATION_MS=100

# --- Transcription -------------------------------------------------------------

VOICE_LIVE_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# VOICE_LIVE_TRANSCRIPTION_PROMPT=

# --- Server -------------------------------------------------------------------

# Flight control is separate from TRIAGE_MODE. Default is fully simulated movement.
DRONE_CONTROL_MODE=mock
DRONE_CONTROL_API_URL=http://127.0.0.1:8766
# Backend only; match the PC service token. Never use NEXT_PUBLIC_ for this value.
# DRONE_CONTROL_API_TOKEN=
# Live additionally requires TRIAGE_MODE=azure and a ready PC site profile.

# --- Private outbound PC channel (disabled by default) -------------------------
# local preserves the existing mock voice UI and fixed loopback HTTP behavior.
DRONE_CONTROL_TRANSPORT=local
# Explicit MOCK E2E only: 1 runs the SAME seven tools and attributed PC captures,
# not the default MissionRunner simulation. PC needs DRONE_CONTROL_MOCK_CAPTURES=1.
DRONE_CONTROL_USE_TOOLS=0
# In remote mode all four settings below are mandatory. Trusted operator config,
# never tool arguments. Device/local API/operator credentials MUST be different.
# DRONE_REMOTE_DEVICE_ID=operator-configured-pc
# DRONE_REMOTE_DEVICE_TOKEN=<private-random-device-token>
# DRONE_REMOTE_EXECUTION_MODE=mock
# DRONE_REMOTE_SINGLE_REPLICA=1
# Device tokens are private random URL-safe strings, 32..256 characters.
# Expected mode MUST equal DRONE_CONTROL_MODE on the cloud. Remote mock /ws
# refuses to run unless DRONE_CONTROL_USE_TOOLS=1; it never falls back to the
# default simulated MissionRunner when the remote device is unavailable.
# Remote mode uses an IN-MEMORY hub: deployment MUST have minReplicas=1 and
# maxReplicas=1 and one Python worker. Existing min=0/max=3 is NOT supported.
# Setting the acknowledgement does NOT reconfigure Azure. No deployment is done
# automatically. Future scale-out requires an external ownership/routing system.

# PC connector process only: python -m relay.pc_connector (existing relay venv).
# Opens one outbound TLS websocket; never open/tunnel 8766/9997/9998/9999.
# Exact hostname, no query/fragment/userinfo, redirects or environment proxies.
# DRONE_RELAY_URL=wss://idd-relay.livelysky-9813bb2d.southeastasia.azurecontainerapps.io/ws/device
# DRONE_RELAY_ALLOWED_HOST=idd-relay.livelysky-9813bb2d.southeastasia.azurecontainerapps.io
# Connector also needs DRONE_REMOTE_DEVICE_ID/TOKEN/EXECUTION_MODE above, plus
# its SEPARATE DRONE_CONTROL_API_TOKEN. Cloud remote relay needs no local token.
# Live requires BOTH PC's own live gates AND this separate connector opt-in:
# DRONE_CONNECTOR_ALLOW_LIVE=1
# Explicit localhost tests ONLY; production must use WSS:
# DRONE_CONNECTOR_ALLOW_LOOPBACK_TEST=1
# No configurable PC target: connector hardcodes http://127.0.0.1:8766.
# Local service must advertise expected_mode_guard=true and atomically enforce
# X-Drone-Expected-Mode. The connector refuses old/mismatched APIs.
# Requests carry exact {arguments,caller_id,request_id}; rpc_id is a separate,
# monotonic per-generation integer. At most 32 concurrent requests, 64 KiB
# request / 40 MiB response. No write replay after timeout/disconnect/reconnect.
# Loss stops lease renewal; the PC owner lease (10 seconds) cancels hardware.
# Each mission client stays bound to its first connection generation. Even a
# fast reconnect cannot resume the previous owner's lease (REMOTE_SESSION_LOST).
# A new explicit recovery client can read admission by the original caller and
# business request ID, but the connector never replays an abandoned write.
# RC/operator verification remains required for unknown stop/landing outcomes.

# --- Backend operator authorization (frontend does NOT implement this yet) -----
# Required for /ws and /ws/camera in remote OR live mode, plus live diagnostics.
# Provision one private, operator-specific random URL-safe token (32..256 chars)
# per operator deployment, rotate/revoke by backend configuration. Not a shared
# frontend constant, NEXT_PUBLIC variable, web PIN, Origin, or query parameter.
# RELAY_OPERATOR_TOKEN=<private-operator-specific-token>
# Optional existing-dashboard cookie compatibility; EXACT relay HTTPS origin:
# RELAY_PUBLIC_ORIGIN=https://idd-relay.livelysky-9813bb2d.southeastasia.azurecontainerapps.io
# HTTP: Authorization: Bearer <token>
# Browser WebSocket: new WebSocket(url,
#   ["relay.operator.v1", "relay.token." + token])
# Server selects ONLY relay.operator.v1, never echoes the credential protocol.
# Existing-browser workflow (no frontend changes): open the relay's HTTPS
# /operator page directly, enter the operator token explicitly, then return to
# the dashboard and reconnect. The relay issues a __Host-relay_operator cookie:
# Secure, HttpOnly, Path=/, no Domain, SameSite=None, 15-minute non-sliding TTL.
# Cookies are opaque; tokens are never embedded in HTML, bundles, URLs or storage.
# Browser policy may block third-party cookies on the dashboard's WebSocket.
# In that case this workflow cannot authorize the existing UI: use an approved
# bearer/subprotocol client. No browser-security bypass or automatic Origin auth.
# This provides sign-in, NOT a new frontend safety/arming UI; PC live gates remain.
# Main's current web PIN is NOT forwarded. Clients without valid auth receive
# relay.error OPERATOR_AUTH_REQUIRED before a mission runner/preview is created.
# API workflow from the exact RELAY_PUBLIC_ORIGIN: GET /api/operator/session
# (retain CSRF cookie, read csrfToken); POST /api/operator/session with JSON
# {"token":"<explicit user input>"}, X-CSRF-Token header and cookie credentials.
# POST requires the exact configured Origin, signed double-submit CSRF and a
# bounded JSON body. DELETE the same endpoint with Origin/CSRF to sign out.
# 8 attempts/client/minute and 32 total/minute; max 128 sessions, no persistence.
# Re-login revokes the old browser session; logout/token rotation/server restart
# invalidate sessions. Cookie-authenticated sockets close within one second of
# expiry/revocation and normal mission cleanup/owner-lease cancellation applies.
# Sessions use the same single-replica/single-worker constraint as the RPC hub.
# Keep secrets out of URLs, logs, diagnostics and image output.
# Default local/mock voice UX remains unauthenticated and unchanged.
# python -m relay.server sets ws_max_size=41943040. If invoking uvicorn directly,
# supply --ws-max-size 41943040 --ws-max-queue 2 --workers 1.

RELAY_HOST=127.0.0.1
RELAY_PORT=8080
# Exact additional dashboard origins; never use a wildcard for a physical controller.
RELAY_WEB_ORIGINS=https://idd-web.livelysky-9813bb2d.southeastasia.azurecontainerapps.io
# RELAY_WEB_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?
