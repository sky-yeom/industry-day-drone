# Copy to an ignored .env.drone.local file; these values stay in Python backends.
DRONE_CONTROL_MODE=mock
DRONE_CONTROL_ADAPTER=legacy
# Explicit software E2E only: canonical fixture + distinctly marked synthetic PNG.
# DRONE_CONTROL_MOCK_CAPTURES=1
DRONE_CONTROL_API_URL=http://127.0.0.1:8766
DRONE_CONTROL_API_TOKEN=REPLACE_ME
TRIAGE_MODE=mock
# Field is explicit; there is no fallback from invalid field settings to legacy.
# DRONE_CONTROL_ADAPTER=field
# Live requires APK.6 and independently confirmed private setup/site facts.
# DRONE_CONTROL_ENABLE_LIVE=1
# DRONE_CONTROL_SITE_CONFIG=C:\private\field-site.local.json
# DRONE_CONTROL_CONFIG_PATH=C:\private\config.local.json
# DRONE_CONTROL_FIELD_PROFILE=C:\checkout\drone-control\trials\profiles\standalone_tag_6321236.json
# DRONE_CONTROL_FIELD_REFERENCE=C:\checkout\drone-control\trials\profiles\id1_tv_pair_reference.json
# The legacy adapter uses integration/site.example.json; field uses the separate
# private schema documented in docs/CONTROL_INTEGRATION_20260910.md.
# Set TRIAGE_MODE=azure for live images and supply the relay's Azure settings.
