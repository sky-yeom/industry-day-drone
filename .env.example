# Next.js dashboard environment template.
# Copy to .env.local (gitignored) and adjust if your relay runs elsewhere.
#
#   cp .env.example .env.local

# HTTP/WebSocket base URLs the browser uses to reach the Python relay.
# Defaults (used when unset) match a relay started with its own defaults.
NEXT_PUBLIC_RELAY_HTTP=http://127.0.0.1:8080
NEXT_PUBLIC_RELAY_WS=ws://127.0.0.1:8080/ws
